# SonarQube Configuration
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to git!

# SonarQube Server URL
# For SonarCloud: https://sonarcloud.io
# For self-hosted: https://your-sonarqube-server.com
SONARQUBE_URL=https://sonarcloud.io

# SonarQube Authentication Token
# Generate at: Account → Security → Generate Token
SONARQUBE_TOKEN=your_token_here

# Organization Key (SonarCloud only)
# Find at: https://sonarcloud.io/account/organizations
SONARQUBE_ORG=your_organization_key

# Project Key
SONARQUBE_PROJECT_KEY=nyc-taxi-income-optimizer
