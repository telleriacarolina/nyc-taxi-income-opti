{
    "name": "spark-template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "kill": "fuser -k 5000/tcp",
        "build": "tsc -b --noCheck && vite build",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint .",
        "optimize": "vite optimize",
        "preview": "vite preview",
        "verify:openfreemap": "chmod +x verify-openfreemap.sh && ./verify-openfreemap.sh",
        "fetch:openfreemap": "git fetch openfreemap && echo '✅ OpenFreeMap updates fetched'",
        "check:openfreemap": "git fetch openfreemap && git log HEAD..openfreemap/main --oneline && git rev-list HEAD..openfreemap/main --count | xargs -I {} echo 'New commits: {}'",
        "compare:openfreemap": "git fetch openfreemap && git diff --stat main openfreemap/main",
        "review:openfreemap": "git fetch openfreemap && git log openfreemap/main --oneline --graph -20 --pretty=format:'%Cred%h%Creset - %s %Cgreen(%cr)%Creset'",
        "sonar:scan": "SONAR_TOKEN=squ_6241673fd76f79869c9dc0b1bc61e7bd89e99d6f sonar-scanner",
        "sonar:analyze": "npm run test:coverage && npm run sonar:scan",
        "sonar:diagnose": "chmod +x scripts/diagnose-sonar.sh && ./scripts/diagnose-sonar.sh",
        "sonar:install": "npm install --save-dev sonarqube-scanner @vitest/coverage-v8 vitest @testing-library/react @testing-library/jest-dom jsdom",
        "docker:dev": "docker compose up dev",
        "docker:dev:build": "docker compose up --build dev",
        "docker:prod": "docker compose up -d prod",
        "docker:prod:build": "docker compose up -d --build prod",
        "docker:build": "docker build -t nyc-taxi-optimizer .",
        "docker:build:dev": "docker build -f Dockerfile.dev -t nyc-taxi-optimizer:dev .",
        "docker:stop": "docker compose down",
        "docker:clean": "docker compose down -v && docker rmi nyc-taxi-optimizer nyc-taxi-optimizer:dev 2>/dev/null || true",
        "docker:logs": "docker compose logs -f",
        "docker:restart": "docker compose restart",
        "docker:check": "chmod +x scripts/docker/docker-check.sh && ./scripts/docker/docker-check.sh",
        "docker:status": "chmod +x scripts/docker/DOCKER_STATUS.sh && ./scripts/docker/DOCKER_STATUS.sh"
    },
    "dependencies": {
        "@github/spark": ">=0.43.1 <1",
        "@heroicons/react": "^2.2.0",
        "@hookform/resolvers": "^4.1.3",
        "@octokit/core": "^6.1.4",
        "@phosphor-icons/react": "^2.1.7",
        "@radix-ui/colors": "^3.0.0",
        "@radix-ui/react-accordion": "^1.2.3",
        "@radix-ui/react-alert-dialog": "^1.1.6",
        "@radix-ui/react-aspect-ratio": "^1.1.2",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-context-menu": "^2.2.6",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-hover-card": "^1.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-menubar": "^1.1.6",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-popover": "^1.1.6",
        "@radix-ui/react-progress": "^1.1.2",
        "@radix-ui/react-radio-group": "^1.2.3",
        "@radix-ui/react-scroll-area": "^1.2.9",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slider": "^1.3.6",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-switch": "^1.1.3",
        "@radix-ui/react-tabs": "^1.1.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/vite": "^4.1.11",
        "@tanstack/react-query": "^5.83.1",
        "@types/leaflet": "^1.9.21",
        "@types/leaflet.heat": "^0.2.5",
        "@types/leaflet.markercluster": "^1.5.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "d3": "^7.9.0",
        "date-fns": "^3.6.0",
        "embla-carousel-react": "^8.5.2",
        "framer-motion": "^12.6.2",
        "input-otp": "^1.4.2",
        "leaflet": "^1.9.4",
        "leaflet.heat": "^0.2.0",
        "leaflet.markercluster": "^1.5.3",
        "lucide-react": "^0.484.0",
        "marked": "^15.0.7",
        "next-themes": "^0.4.6",
        "octokit": "^4.1.2",
        "react": "^19.0.0",
        "react-day-picker": "^9.6.7",
        "react-dom": "^19.0.0",
        "react-error-boundary": "^6.0.0",
        "react-hook-form": "^7.54.2",
        "react-resizable-panels": "^2.1.7",
        "recharts": "^2.15.1",
        "sonner": "^2.0.1",
        "tailwind-merge": "^3.0.2",
        "three": "^0.175.0",
        "tw-animate-css": "^1.2.4",
        "uuid": "^11.1.0",
        "vaul": "^1.1.2",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@tailwindcss/postcss": "^4.1.8",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react-swc": "^4.2.2",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/ui": "^4.0.18",
        "eslint": "^9.28.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "jsdom": "^27.4.0",
        "sonarqube-scanner": "^4.3.4",
        "tailwindcss": "^4.1.11",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.38.0",
        "vite": "^7.2.6",
        "vitest": "^4.0.18"
    },
    "workspaces": {
        "packages": [
            "packages/*"
        ]
    }
}
