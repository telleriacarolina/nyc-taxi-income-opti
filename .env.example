# NYC TLC Driver Hub - Environment Configuration Example
# Copy this file to .env.local and customize for your environment
# NEVER commit .env or .env.local files to version control

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

VITE_APP_NAME="NYC TLC Driver Hub"
VITE_APP_VERSION="1.0.0"
VITE_ENVIRONMENT="development"

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable GPS-based features (route generation from current location)
VITE_ENABLE_GPS_FEATURES=true

# Enable/disable AI-powered insights and recommendations
VITE_ENABLE_AI_FEATURES=true

# Enable/disable driver chatroom feature
VITE_ENABLE_CHATROOM=true

# Enable/disable notification features (SMS, email, push)
VITE_ENABLE_NOTIFICATIONS=true

# Enable/disable location-based heatmaps and analytics
VITE_ENABLE_LOCATION_ANALYTICS=true

# ============================================================================
# EXTERNAL API ENDPOINTS (Public APIs - No Authentication Required)
# ============================================================================

# NYC Open Data - TLC Base Aggregate Report
# Source: https://data.cityofnewyork.us/Transportation/TLC-Base-Aggregate-Report/2v9c-2k7f
VITE_TLC_BASE_AGGREGATE_API="https://data.cityofnewyork.us/resource/2v9c-2k7f.json"

# NYC Open Data - FHV Bases
# Source: https://data.cityofnewyork.us/Transportation/FHV-Bases/eccv-9dzr
VITE_TLC_BASES_API="https://data.cityofnewyork.us/resource/eccv-9dzr.json"

# NYC Open Data - High Volume FHV Trip Records
# Source: https://data.cityofnewyork.us/Transportation/High-Volume-FHV-Trip-Records/8wbx-tsch
VITE_TLC_TRIPS_API="https://data.cityofnewyork.us/resource/8wbx-tsch.json"

# OpenFreeMap Tiles (No API key required)
# Source: https://openfreemap.org/
VITE_MAP_TILE_URL="https://tiles.openfreemap.org/styles/liberty/{z}/{x}/{y}.png"

# ============================================================================
# SECURITY & PRIVACY
# ============================================================================

# Enable debug logging (DISABLE IN PRODUCTION)
VITE_ENABLE_DEBUG_LOGS=false

# Enable analytics/telemetry (DISABLE FOR PRIVACY)
VITE_ENABLE_ANALYTICS=false

# Mask sensitive data in UI by default
VITE_DEFAULT_PRIVACY_MODE=false

# ============================================================================
# DATA RETENTION POLICIES (days)
# ============================================================================

# Chat message retention (90 days recommended)
VITE_CHAT_MESSAGE_RETENTION=90

# Shift data retention (2555 days = 7 years for IRS tax records)
VITE_SHIFT_DATA_RETENTION=2555

# Ride data retention (2555 days = 7 years for IRS tax records)
VITE_RIDE_DATA_RETENTION=2555

# Notification history retention (365 days = 1 year)
VITE_NOTIFICATION_HISTORY_RETENTION=365

# ============================================================================
# API RATE LIMITING
# ============================================================================

# Maximum NYC Open Data API requests per minute
VITE_API_RATE_LIMIT_PER_MINUTE=60

# API request timeout (milliseconds)
VITE_API_TIMEOUT_MS=10000

# ============================================================================
# NOTIFICATION CONFIGURATION
# ============================================================================

# Default reminder intervals (comma-separated days)
VITE_DEFAULT_REMINDER_INTERVALS="1,7,14,30"

# Default notification channels (comma-separated: in-app,sms,email,push)
VITE_DEFAULT_NOTIFICATION_CHANNELS="in-app"

# ============================================================================
# GEOLOCATION CONFIGURATION
# ============================================================================

# Geolocation timeout (milliseconds)
VITE_GEOLOCATION_TIMEOUT_MS=10000

# Geolocation maximum age (milliseconds)
VITE_GEOLOCATION_MAX_AGE_MS=60000

# High accuracy mode (uses GPS, higher battery usage)
VITE_GEOLOCATION_HIGH_ACCURACY=true

# ============================================================================
# AI/LLM CONFIGURATION
# ============================================================================

# Default LLM model for AI features (gpt-4o or gpt-4o-mini)
VITE_DEFAULT_LLM_MODEL="gpt-4o-mini"

# Enable JSON mode for structured AI responses
VITE_LLM_JSON_MODE=true

# AI response timeout (milliseconds)
VITE_LLM_TIMEOUT_MS=30000

# ============================================================================
# DEVELOPMENT/TESTING
# ============================================================================

# Enable test mode (uses mock data instead of APIs)
VITE_ENABLE_TEST_MODE=false

# Mock API delay (milliseconds, for testing loading states)
VITE_MOCK_API_DELAY_MS=1000

# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# ============================================================================
# PRODUCTION-SPECIFIC SETTINGS
# ============================================================================

# For production deployment, create a .env.production file with:
# VITE_ENVIRONMENT="production"
# VITE_ENABLE_DEBUG_LOGS=false
# VITE_ENABLE_ANALYTICS=false
# VITE_DEFAULT_PRIVACY_MODE=true

# ============================================================================
# SECURITY NOTES
# ============================================================================

# 1. NEVER commit files containing actual secrets to version control
# 2. This file contains NO secrets - all APIs are public
# 3. Add .env and .env.local to .gitignore (already configured)
# 4. For future features requiring secrets, use:
#    - Environment variables on hosting platform
#    - Secret management services (AWS Secrets Manager, etc.)
# 5. Never log environment variables in production
# 6. Rotate any exposed secrets immediately

